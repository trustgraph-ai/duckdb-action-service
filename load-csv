#!/usr/bin/env python3
"""
Load CSV files into a DuckDB database.

Usage:
    ./load-csv <csv-dir> [output.duckdb]

Loads every .csv file in <csv-dir> as a materialised table, named after
the file (e.g. departments.csv -> departments).
"""

import sys
import os
import glob

import duckdb

def main():
    if len(sys.argv) < 2:
        print(f"Usage: {sys.argv[0]} <csv-dir> [output.duckdb]", file=sys.stderr)
        sys.exit(1)

    csv_dir = sys.argv[1]
    db_path = sys.argv[2] if len(sys.argv) > 2 else "data.duckdb"

    if os.path.exists(db_path):
        os.remove(db_path)

    conn = duckdb.connect(db_path)

    csv_files = sorted(glob.glob(os.path.join(csv_dir, "*.csv")))
    if not csv_files:
        print(f"No .csv files found in {csv_dir}", file=sys.stderr)
        sys.exit(1)

    for path in csv_files:
        table_name = os.path.splitext(os.path.basename(path))[0]
        conn.execute(
            f'CREATE TABLE "{table_name}" AS '
            f"SELECT * FROM read_csv_auto('{path}')"
        )
        count = conn.execute(f'SELECT count(*) FROM "{table_name}"').fetchone()[0]
        print(f"  {table_name}: {count} rows")

    conn.close()
    print(f"\nWrote {db_path}")

if __name__ == "__main__":
    main()
